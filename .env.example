# ─────────────────────────────────────────────────────────────────────────────
# MarrowStack — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── NextAuth (v5) ─────────────────────────────────────────────────────────────
# AUTH_SECRET: generate with: openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_32_BYTE_RANDOM_SECRET
# AUTH_URL: your canonical production URL (NextAuth v5 uses this for callbacks)
AUTH_URL=https://marrowstack.dev

# ── GitHub OAuth (for buyer sign-in) ─────────────────────────────────────────
# Create at: https://github.com/settings/apps
# Callback URL: https://your-domain.com/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# ── GitHub Delivery ───────────────────────────────────────────────────────────
# Each block lives in its own private repo. Buyers receive a collaborator
# invitation to the repo for the specific block they purchased.
#
# GITHUB_DELIVERY_PAT: Classic PAT on the account that owns all delivery repos.
# Requires the `repo` scope (classic) or "Collaborators: Write" (fine-grained).
# Never commit this value. Server-side only.
GITHUB_DELIVERY_PAT=ghp_your_delivery_personal_access_token
#
# Per-block repo mapping. Pattern: GITHUB_REPO_{BLOCK_ID_UPPERCASE}
# Add one line per block — use the same format: owner/repo-name
GITHUB_REPO_AUTH=your-org/block-auth
GITHUB_REPO_ADMIN=your-org/block-admin
GITHUB_REPO_TEAMSPACE=your-org/block-teamspace
GITHUB_REPO_SOLANA_AUTH=your-org/block-solana-auth
GITHUB_REPO_SOLANA_PAYMENTS=your-org/block-solana-payments
# Add more as you ship new blocks:
# GITHUB_REPO_BILLING=your-org/block-billing

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key — server-side ONLY, never ship to client
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Dodo Payments (fiat / merchant-of-record) ─────────────────────────────────
# https://docs.dodopayments.com
# 1. Create a Dodo account → get API key from Settings → API Keys
# 2. Create one Product per block in the Dodo dashboard with the fixed price, copy the product_id
# 3. Register webhook: POST https://yourdomain.com/api/webhooks/dodo
#    Signature spec: standardwebhooks (webhook-id / webhook-signature / webhook-timestamp headers)
# 4. Copy webhook signing secret → DODO_PAYMENTS_WEBHOOK_SECRET
DODO_PAYMENTS_API_KEY=your_dodo_api_key
DODO_PAYMENTS_WEBHOOK_SECRET=your_dodo_webhook_signing_secret
# 'live' or 'test' — controls which Dodo base URL is used
# live → https://live.dodopayments.com
# test → https://test.dodopayments.com
DODO_PAYMENTS_MODE=live

# Dodo product IDs (create each block as a product in Dodo dashboard)
# Format: DODO_PRODUCT_ID_{BLOCK_ID_UPPERCASE}
DODO_PRODUCT_ID_AUTH=prod_xxxxxxxxxxxxxxxx
DODO_PRODUCT_ID_ADMIN=prod_xxxxxxxxxxxxxxxx
DODO_PRODUCT_ID_TEAMSPACE=prod_xxxxxxxxxxxxxxxx
DODO_PRODUCT_ID_SOLANA_AUTH=prod_xxxxxxxxxxxxxxxx
DODO_PRODUCT_ID_SOLANA_PAYMENTS=prod_xxxxxxxxxxxxxxxx

# ── Solana — STORE (MAINNET ONLY) ────────────────────────────────────────────
# WARNING: This is the PRODUCTION treasury. Must be mainnet-beta.
# The playground (Phase 1) uses its own separate devnet config and must NEVER
# share this address, RPC, or key. This is asserted at boot.
STORE_SOL_TREASURY_ADDRESS=your_mainnet_phantom_wallet_public_key
# Helius, QuickNode, or other mainnet RPC — MUST contain "mainnet"
STORE_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_key
# USDC mint on mainnet
STORE_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# 'sol' or 'usdc' — default crypto rail shown to buyers
STORE_CRYPTO_DEFAULT=usdc

# ── PayPal (legacy — disabled by default) ────────────────────────────────────
# Set to 'true' to re-enable PayPal checkout. Historical orders are unaffected
# regardless of this flag.
ENABLE_PAYPAL=false
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ── Email (SMTP via nodemailer) ───────────────────────────────────────────────
# Use any SMTP provider (Postmark, Resend SMTP, AWS SES, Gmail).
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=your_smtp_api_token
SMTP_PASS=your_smtp_api_token
EMAIL_FROM=noreply@marrowstack.dev

# ── Price Feed ────────────────────────────────────────────────────────────────
# Optional: CoinGecko Pro API key for higher rate limits
COINGECKO_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://marrowstack.dev

# ── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated list of email addresses granted access to /admin routes.
ADMIN_EMAILS=admin@marrowstack.dev

