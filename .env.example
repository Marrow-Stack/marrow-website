# ─────────────────────────────────────────────────────────────────────────────
# MarrowStack — Environment Variables
#
# TWO SEPARATE ENVIRONMENTS ARE REQUIRED:
#   .env.local      → dev:  devnet + Dodo test mode + test OAuth + test GitHub org
#   .env.production → prod: mainnet-beta + Dodo live + prod OAuth + real GitHub org
#
# The app enforces this at boot — wrong cluster or Dodo mode = refuses to start.
# NEVER commit either file. NEVER cross-wire dev and prod credentials.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development                              # prod: production

NEXT_PUBLIC_APP_URL=http://localhost:3000         # prod: https://marrowstack.dev

# ── Supabase ──────────────────────────────────────────────────────────────────
# Use SEPARATE Supabase projects for dev and prod.
# Enable Point-in-Time Recovery on the PROD project before going live ($25/mo).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...                 # server-side ONLY, never ship to client

# ── NextAuth v5 ───────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
AUTH_SECRET=at_least_32_chars_random_secret
AUTH_URL=http://localhost:3000                    # prod: https://marrowstack.dev

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Dev OAuth App:  http://localhost:3000 / callback: http://localhost:3000/api/auth/callback/github
# Prod OAuth App: https://marrowstack.dev / callback: https://marrowstack.dev/api/auth/callback/github
# Register at: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=Iv1.xxx
GITHUB_CLIENT_SECRET=xxx

# ── GitHub Delivery ───────────────────────────────────────────────────────────
# PAT with repo:invite scope. Dev: use a test org. Prod: use the real Marrow-Stack org.
GITHUB_DELIVERY_PAT=ghp_xxx

# Per-block repo mapping. Pattern: GITHUB_REPO_{BLOCK_ID_UPPERCASE}
# Dev example:  GITHUB_REPO_AUTH=Marrow-Stack-Test/block-auth
# Prod example: GITHUB_REPO_AUTH=Marrow-Stack/block-auth
GITHUB_REPO_AUTH=your-org/block-auth
GITHUB_REPO_SOLANA_AUTH=your-org/block-solana-auth
GITHUB_REPO_SOLANA_PAYMENTS=your-org/block-solana-payments
# Add one line per block:
# GITHUB_REPO_ADMIN=your-org/block-admin
# GITHUB_REPO_TEAMSPACE=your-org/block-teamspace

# ── Dodo Payments ─────────────────────────────────────────────────────────────
# Dev:  DODO_PAYMENTS_MODE=test  → https://test.dodopayments.com
# Prod: DODO_PAYMENTS_MODE=live  → https://live.dodopayments.com
# The app refuses to start with live keys in a non-production environment.
# Prod webhook URL: https://marrowstack.dev/api/webhooks/dodo
DODO_PAYMENTS_API_KEY=test_xxx              # prod: live_xxx
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_xxx
DODO_PAYMENTS_MODE=test                     # prod: live

# Dodo product IDs (create each block as a Product in the Dodo dashboard):
DODO_PRODUCT_ID_AUTH=prod_xxx
DODO_PRODUCT_ID_SOLANA_AUTH=prod_xxx
DODO_PRODUCT_ID_SOLANA_PAYMENTS=prod_xxx
# DODO_PRODUCT_ID_ADMIN=prod_xxx

# ── Solana ────────────────────────────────────────────────────────────────────
# Dev:  SOLANA_CLUSTER_STORE=devnet     — uses devnet RPC, devnet USDC mint
# Prod: SOLANA_CLUSTER_STORE=mainnet-beta — uses mainnet RPC, mainnet USDC mint
# The app refuses to start with mainnet-beta in a non-production environment.
SOLANA_CLUSTER_STORE=devnet             # prod: mainnet-beta

# Use a private RPC for ALL server-side calls (never the public endpoint).
# Providers: Helius (https://helius.dev), QuickNode, Jito
# Dev RPC example:  https://devnet.helius-rpc.com/?api-key=xxx
# Prod RPC example: https://mainnet.helius-rpc.com/?api-key=xxx
STORE_SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=xxx

# Treasury wallet — receives all crypto payments.
# Dev: any devnet wallet you control.
# Prod: your Phantom mainnet pubkey. Known devnet test addresses are rejected at boot.
STORE_SOL_TREASURY_ADDRESS=YourBase58PublicKeyHere

# USDC mint address:
# Devnet mainnet:  4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Mainnet-beta: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
STORE_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU  # prod: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

STORE_CRYPTO_DEFAULT=usdc               # 'usdc' or 'sol'

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_FROM=samarth@marrowstack.dev

# SMTP (optional — without this, delivery emails log to console in dev)
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=your_smtp_api_token
SMTP_PASS=your_smtp_api_token

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=samarth@marrowstack.dev

# ── CoinGecko (optional) ──────────────────────────────────────────────────────
# Pro key for higher rate limits on SOL/USD price feed.
# Without this, the free public endpoint is used (fine for low traffic).
# COINGECKO_API_KEY=CG-xxx

# ── Rate Limiting (optional but recommended for production) ───────────────────
# Upstash Redis for distributed rate limiting across Vercel edge instances.
# Without these, an in-process sliding window is used (resets on cold-start).
# Create a free Upstash Redis database at https://upstash.com
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# ── Kill Switch ───────────────────────────────────────────────────────────────
# Set to 'true' to disable checkout + delivery while keeping marketing live.
# Checkout routes return 503. Marketing/docs/changelog remain accessible.
# MAINTENANCE_MODE=true
