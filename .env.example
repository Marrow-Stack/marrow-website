# ─────────────────────────────────────────────────────────────────────────────
# MarrowStack — Environment Variables
#
# Copy to .env.local for development, or set directly in your hosting dashboard.
# NEVER commit this file with real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://marrowstack.dev

# ── Supabase ──────────────────────────────────────────────────────────────────
# Use a dedicated project for production. Enable Point-in-Time Recovery ($25/mo).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # server-side only — never expose to client

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate AUTH_SECRET:  openssl rand -hex 32

AUTH_SECRET=replace_with_openssl_rand_hex_32_output
AUTH_URL=https://marrowstack.dev

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/applications/new
# Homepage URL:      https://marrowstack.dev
# Callback URL:      https://marrowstack.dev/api/auth/callback/github

GITHUB_CLIENT_ID=Iv1.xxx
GITHUB_CLIENT_SECRET=xxx

# ── GitHub read PAT (required in prod) ───────────────────────────────────────
# Fine-grained PAT: Contents = read-only on all Marrow-Stack repos.
# Without this: 60 req/hr (anonymous). With it: 5000 req/hr.
# Create at: https://github.com/settings/personal-access-tokens/new

GITHUB_TOKEN=github_pat_xxx

# ── Privacy: IP hashing ───────────────────────────────────────────────────────
# Used for rate-limiting and feedback votes without storing raw IPs.
# Generate:  openssl rand -hex 32

IP_HASH_SECRET=replace_with_openssl_rand_hex_32_output

# ── Optional ──────────────────────────────────────────────────────────────────

# Cache invalidation endpoint token  (POST /api/revalidate?tag=...&token=...)
ADMIN_REVALIDATE_TOKEN=replace_with_random_string

# Comma-separated emails allowed to access /admin
ADMIN_EMAILS=samarth@marrowstack.dev

# Footer "Built by" link
NEXT_PUBLIC_OWNER_GITHUB_URL=https://github.com/samarth-shukla

# Transactional email via Resend (teaser signup confirmations)
# RESEND_API_KEY=re_xxx
